--========================================================--
-- SAFE
--========================================================--

local function safe(fn)

	pcall(fn)

end


--========================================================--
-- SAFE PROPERTY SET
--========================================================--

local function safeSet(
	object,
	property,
	value
)

	pcall(
		function()

			object[property] = value

		end
	)

end


--========================================================--
-- FORCE GRAPHICS QUALITY
--========================================================--

local function forceGraphicsQuality()


	local gameSettings =
		UserSettings().GameSettings


	safe(
		function()

			gameSettings.SavedQualityLevel =
				CONFIG.TARGET_GRAPHICS_QUALITY

		end
	)

end


--========================================================--
-- FULLBRIGHT
--========================================================--
--
-- Roblox:
--
-- GlobalShadows = false
--     ->
-- Ambient được áp dụng đồng đều.
--
-- EnvironmentDiffuseScale = 0
--     ->
-- không lấy dynamic environment diffuse.
--
-- EnvironmentSpecularScale = 0
--     ->
-- không lấy environment specular.
--
-- Brightness = 0
--     ->
-- không lấy phần contribution chính từ Sun/Moon.
--
--========================================================--

local function forceFullBright()


	if not CONFIG.ENABLE_FULLBRIGHT then

		return

	end


	--====================================================--
	-- NO GLOBAL SHADOW
	--====================================================--

	safeSet(
		Lighting,
		"GlobalShadows",
		false
	)


	--====================================================--
	-- NO SUN / MOON CONTRIBUTION
	--====================================================--

	safeSet(
		Lighting,
		"Brightness",
		CONFIG.FULLBRIGHT_BRIGHTNESS
	)


	--====================================================--
	-- UNIFORM AMBIENT
	--====================================================--

	safeSet(
		Lighting,
		"Ambient",
		CONFIG.FULLBRIGHT_AMBIENT
	)


	--====================================================--
	-- UNIFORM OUTDOOR AMBIENT
	--====================================================--

	safeSet(
		Lighting,
		"OutdoorAmbient",
		CONFIG.FULLBRIGHT_OUTDOOR_AMBIENT
	)


	--====================================================--
	-- NO COLOR SHIFT
	--====================================================--

	safeSet(
		Lighting,
		"ColorShift_Top",
		CONFIG.FULLBRIGHT_COLOR_SHIFT
	)


	safeSet(
		Lighting,
		"ColorShift_Bottom",
		CONFIG.FULLBRIGHT_COLOR_SHIFT
	)


	--====================================================--
	-- NO EXPOSURE BOOST
	--====================================================--

	safeSet(
		Lighting,
		"ExposureCompensation",
		CONFIG.FULLBRIGHT_EXPOSURE
	)


end


--========================================================--
-- FORCE LIGHTING MINIMUM
--========================================================--

local function forceLighting()


	--====================================================--
	-- FULLBRIGHT
	--====================================================--

	forceFullBright()


	--====================================================--
	-- SHADOW
	--====================================================--

	if CONFIG.DISABLE_GLOBAL_SHADOWS then

		safeSet(
			Lighting,
			"GlobalShadows",
			false
		)

	end


	--====================================================--
	-- DIFFUSE
	--====================================================--

	if CONFIG.DISABLE_ENVIRONMENT_DIFFUSE then

		safeSet(
			Lighting,
			"EnvironmentDiffuseScale",
			0
		)

	end


	--====================================================--
	-- SPECULAR
	--====================================================--

	if CONFIG.DISABLE_ENVIRONMENT_SPECULAR then

		safeSet(
			Lighting,
			"EnvironmentSpecularScale",
			0
		)

	end


	--====================================================--
	-- SHADOW SOFTNESS
	--====================================================--

	safeSet(
		Lighting,
		"ShadowSoftness",
		0
	)


	--====================================================--
	-- FOG
	--====================================================--

	if CONFIG.DISABLE_FOG then

		safeSet(
			Lighting,
			"FogStart",
			0
		)


		safeSet(
			Lighting,
			"FogEnd",
			1000000
		)

	end

end


--========================================================--
-- DISABLE EVERY LIGHT
--========================================================--
--
-- PointLight
-- SpotLight
-- SurfaceLight
--
-- đều kế thừa Light.
--
--========================================================--

local function disableAllLights(obj)


	if not CONFIG.DISABLE_ALL_LIGHTS then

		return

	end


	if not obj:IsA("Light") then

		return

	end


	--====================================================--
	-- OFF
	--====================================================--

	safeSet(
		obj,
		"Enabled",
		false
	)


	--====================================================--
	-- ZERO BRIGHTNESS
	--====================================================--

	safeSet(
		obj,
		"Brightness",
		0
	)


	--====================================================--
	-- ZERO RANGE
	--====================================================--

	safeSet(
		obj,
		"Range",
		0
	)


	--====================================================--
	-- SHADOWS OFF
	--====================================================--

	safeSet(
		obj,
		"Shadows",
		false
	)

end


--========================================================--
-- MATERIAL FLATTENER
--========================================================--
--
-- ĐÂY LÀ PHẦN MỚI QUAN TRỌNG.
--
-- Tất cả BasePart được đưa về SmoothPlastic.
--
-- Điều này áp dụng cho:
--
-- Part
-- MeshPart
-- WedgePart
-- CornerWedgePart
-- TrussPart
-- UnionOperation
-- Seat
-- VehicleSeat
-- SpawnLocation
-- v.v.
--
-- bởi vì chúng đều là BasePart.
--
--========================================================--

local function flattenMaterial(obj)


	if not CONFIG.SIMPLIFY_ALL_MATERIALS then

		return

	end


	if not obj:IsA("BasePart") then

		return

	end


	--====================================================--
	-- SMOOTH PLASTIC
	--====================================================--

	safeSet(
		obj,
		"Material",
		CONFIG.FLAT_MATERIAL
	)


	--====================================================--
	-- MATERIAL VARIANT OFF
	--====================================================--

	if CONFIG.REMOVE_MATERIAL_VARIANT then

		safeSet(
			obj,
			"MaterialVariant",
			""
		)

	end


	--====================================================--
	-- REFLECTANCE OFF
	--====================================================--

	safeSet(
		obj,
		"Reflectance",
		0
	)


	--====================================================--
	-- SHADOW OFF
	--====================================================--

	if CONFIG.DISABLE_PART_SHADOWS then

		safeSet(
			obj,
			"CastShadow",
			false
		)

	end


	--====================================================--
	-- GLASS OFF
	--====================================================--
	--
	-- Glass có reflectiveness/distortion riêng.
	--
	--====================================================--

	if CONFIG.FLATTEN_GLASS then

		safe(
			function()

				if obj.Material ==
					Enum.Material.Glass then

					obj.Material =
						Enum.Material.SmoothPlastic

				end

			end
		)

	end

end


--========================================================--
-- MESH TEXTURE OPTIMIZER
--========================================================--
--
-- Mặc định KHÔNG xóa TextureID.
-- Như vậy map vẫn giữ hình ảnh.
--
-- Có thể bật:
--
-- REMOVE_MESHPART_TEXTURES = true
--
-- nếu muốn biến MeshPart thành mesh màu đơn giản nhất.
--
--========================================================--

local function optimizeMeshTexture(obj)


	if not obj:IsA("MeshPart") then

		return

	end


	if not CONFIG.REMOVE_MESHPART_TEXTURES then

		return

	end


	safeSet(
		obj,
		"TextureID",
		""
	)

end


--========================================================--
-- PBR / SURFACE APPEARANCE
--========================================================--

local function optimizeSurfaceAppearance(obj)


	if not CONFIG.REMOVE_SURFACE_APPEARANCE then

		return

	end


	if not obj:IsA("SurfaceAppearance") then

		return

	end


	safe(
		function()

			obj:Destroy()

		end
	)

end


--========================================================--
-- POST EFFECT
--========================================================--

local function disablePostEffect(obj)


	if not CONFIG.DISABLE_POST_EFFECTS then

		return

	end


	if obj:IsA("PostEffect") then

		safeSet(
			obj,
			"Enabled",
			false
		)

	end

end


--========================================================--
-- ATMOSPHERE / CLOUDS
--========================================================--

local function optimizeLightingChild(obj)


	--====================================================--
	-- POST EFFECT
	--====================================================--

	if obj:IsA("PostEffect") then

		disablePostEffect(obj)

		return

	end


	--====================================================--
	-- ATMOSPHERE
	--====================================================--

	if obj:IsA("Atmosphere")
		and CONFIG.DISABLE_ATMOSPHERE then


		safeSet(
			obj,
			"Density",
			0
		)


		safeSet(
			obj,
			"Haze",
			0
		)


		safeSet(
			obj,
			"Glare",
			0
		)


		return

	end


	--====================================================--
	-- CLOUDS
	--====================================================--

	if obj:IsA("Clouds")
		and CONFIG.DISABLE_CLOUDS then


		safeSet(
			obj,
			"Enabled",
			false
		)


		return

	end

end


--========================================================--
-- TERRAIN / WATER
--========================================================--

local function optimizeTerrain()


	Terrain =
		Workspace:FindFirstChildOfClass("Terrain")


	if not Terrain then

		return

	end


	--====================================================--
	-- TERRAIN DECORATION
	--====================================================--
	--
	-- Có thể bị Not Scriptable.
	-- pcall để không làm script chết.
	--
	--====================================================--

	if CONFIG.DISABLE_TERRAIN_DECORATION then

		safeSet(
			Terrain,
			"Decoration",
			false
		)

	end


	--====================================================--
	-- WATER REFLECTION
	--====================================================--

	if CONFIG.DISABLE_WATER_REFLECTION then

		safeSet(
			Terrain,
			"WaterReflectance",
			0
		)

	end


	--====================================================--
	-- WATER WAVES
	--====================================================--

	if CONFIG.DISABLE_WATER_WAVES then

		safeSet(
			Terrain,
			"WaterWaveSize",
			0
		)


		safeSet(
			Terrain,
			"WaterWaveSpeed",
			0
		)

	end

end


--========================================================--
-- DUST DETECTOR
--========================================================--

local function isDustParticle(obj)


	local name =
		string.lower(
			obj.Name
		)


	local dustWords = {


		"dust",

		"dusty",

		"dustcloud",

		"dust_cloud",

		"dustparticle",

		"dustparticleemitter",


		"debris",

		"debrisfx",

		"debrisparticle",


		"ash",

		"ashparticle",


		"mist",

		"mistparticle",

		"mistfx",


		"fog",

		"fogparticle",


		"pollen",

		"pollenparticle",


		"sand",

		"sandparticle",


		"dirt",

		"dirtparticle",


		"mote",

		"motes",


		"speck",

		"specks",


		"ambientdust",

		"ambient_dust",


		"floatingdust",

		"floating_dust",


		"grounddust",

		"ground_dust",


		"airdust",

		"air_dust",


	}


	for _, word in ipairs(
		dustWords
	) do


		if string.find(
			name,
			word,
			1,
			true
		) then

			return true

		end


	end


	return false

end


--========================================================--
-- PARTICLE OPTIMIZER
--========================================================--

local function minimizeParticle(obj)


	if not obj:IsA("ParticleEmitter") then

		return

	end


	--====================================================--
	-- REMOVE DUST
	--====================================================--

	if CONFIG.DISABLE_DUST
		and isDustParticle(obj) then


		safeSet(
			obj,
			"Enabled",
			false
		)


		safeSet(
			obj,
			"Rate",
			0
		)


		safe(
			function()

				obj:Clear()

			end
		)


		safeSet(
			obj,
			"LocalTransparencyModifier",
			1
		)


		return

	end


	--====================================================--
	-- EXTREME REDUCTION
	--====================================================--

	if not
		CONFIG.ENABLE_EXTREME_PARTICLE_REDUCTION
	then

		return

	end


	--====================================================--
	-- RATE
	--====================================================--

	safe(
		function()

			obj.Rate =
				math.min(
					obj.Rate,
					2
				)

		end
	)


	--====================================================--
	-- LIFETIME
	--====================================================--

	safeSet(
		obj,
		"Lifetime",
		NumberRange.new(
			0.08,
			0.18
		)
	)


	--====================================================--
	-- SIZE
	--====================================================--

	safeSet(
		obj,
		"Size",
		NumberSequence.new(
			0.08
		)
	)


	--====================================================--
	-- MOTION
	--====================================================--

	if CONFIG.DISABLE_PARTICLE_MOTION then


		safeSet(
			obj,
			"Speed",
			NumberRange.new(
				0,
				0
			)
		)


		safeSet(
			obj,
			"Acceleration",
			Vector3.zero
		)


		safeSet(
			obj,
			"VelocityInheritance",
			0
		)


		safeSet(
			obj,
			"Drag",
			1
		)


		safeSet(
			obj,
			"SpreadAngle",
			Vector2.zero
		)


		safeSet(
			obj,
			"VelocitySpread",
			0
		)


	end


	--====================================================--
	-- ROTATION
	--====================================================--

	if CONFIG.DISABLE_PARTICLE_ROTATION then


		safeSet(
			obj,
			"Rotation",
			NumberRange.new(
				0,
				0
			)
		)


		safeSet(
			obj,
			"RotSpeed",
			NumberRange.new(
				0,
				0
			)
		)


	end


	--====================================================--
	-- SQUASH
	--====================================================--

	safeSet(
		obj,
		"Squash",
		NumberSequence.new(
			0
		)
	)


	--====================================================--
	-- Z OFFSET
	--====================================================--

	safeSet(
		obj,
		"ZOffset",
		0
	)


	--====================================================--
	-- PARTICLE LIGHT
	--====================================================--

	if CONFIG.DISABLE_PARTICLE_LIGHTING then


		safeSet(
			obj,
			"LightEmission",
			0
		)


		safeSet(
			obj,
			"LightInfluence",
			1
		)


		safeSet(
			obj,
			"Brightness",
			0
		)


	end


	--====================================================--
	-- FLIPBOOK OFF
	--====================================================--

	if CONFIG.DISABLE_FLIPBOOK_ANIMATION then


		safeSet(
			obj,
			"FlipbookLayout",
			Enum.ParticleFlipbookLayout.None
		)


		safeSet(
			obj,
			"FlipbookFramerate",
			NumberRange.new(
				0,
				0
			)
		)


		safeSet(
			obj,
			"FlipbookStartRandom",
			false
		)


		safeSet(
			obj,
			"FlipbookBlendFrames",
			false
		)


	end


	--====================================================--
	-- TRANSPARENCY SIMPLIFICATION
	--====================================================--

	if CONFIG.REDUCE_PARTICLE_TRANSPARENCY then


		safeSet(
			obj,
			"Transparency",
			NumberSequence.new(
				0
			)
		)


	end


	--====================================================--
	-- NO WIND
	--====================================================--

	safeSet(
		obj,
		"WindAffectsDrag",
		false
	)


	--====================================================--
	-- NOT LOCKED
	--====================================================--

	safeSet(
		obj,
		"LockedToPart",
		false
	)


	--====================================================--
	-- CAMERA FACING
	--====================================================--

	safeSet(
		obj,
		"Orientation",
		Enum.ParticleOrientation.FacingCamera
	)

end


--========================================================--
-- BEAM OPTIMIZER
--========================================================--

local function minimizeBeam(obj)


	if not obj:IsA("Beam") then

		return

	end


	--====================================================--
	-- OPTIONAL FULL OFF
	--====================================================--

	if CONFIG.DISABLE_BEAMS then


		safeSet(
			obj,
			"Enabled",
			false
		)


		return

	end


	if not
		CONFIG.ENABLE_EXTREME_BEAM_REDUCTION
	then

		return

	end


	--====================================================--
	-- TEXTURE ANIMATION
	--====================================================--

	safeSet(
		obj,
		"TextureSpeed",
		0
	)


	--====================================================--
	-- SEGMENTS
	--====================================================--

	safeSet(
		obj,
		"Segments",
		1
	)


	--====================================================--
	-- WIDTH
	--====================================================--

	safe(
		function()

			obj.Width0 =
				math.min(
					obj.Width0,
					0.1
				)

		end
	)


	safe(
		function()

			obj.Width1 =
				math.min(
					obj.Width1,
					0.1
				)

		end
	)


	--====================================================--
	-- CURVE
	--====================================================--

	safeSet(
		obj,
		"CurveSize0",
		0
	)


	safeSet(
		obj,
		"CurveSize1",
		0
	)


	--====================================================--
	-- LIGHT
	--====================================================--

	safeSet(
		obj,
		"LightEmission",
		0
	)


	safeSet(
		obj,
		"LightInfluence",
		1
	)


	safeSet(
		obj,
		"Brightness",
		0
	)


	--====================================================--
	-- TRANSPARENCY
	--====================================================--

	safeSet(
		obj,
		"Transparency",
		NumberSequence.new(
			0
		)
	)

end


--========================================================--
-- TRAIL OPTIMIZER
--========================================================--

local function minimizeTrail(obj)


	if not obj:IsA("Trail") then

		return

	end


	--====================================================--
	-- OPTIONAL FULL OFF
	--====================================================--

	if CONFIG.DISABLE_TRAILS then


		safeSet(
			obj,
			"Enabled",
			false
		)


		return

	end


	if not
		CONFIG.ENABLE_EXTREME_TRAIL_REDUCTION
	then

		return

	end


	--====================================================--
	-- LIFETIME
	--====================================================--

	safe(
		function()

			obj.Lifetime =
				math.min(
					obj.Lifetime,
					0.05
				)

		end
	)


	--====================================================--
	-- MIN LENGTH
	--====================================================--

	safeSet(
		obj,
		"MinLength",
		0
	)


	--====================================================--
	-- WIDTH
	--====================================================--

	safeSet(
		obj,
		"WidthScale",
		NumberSequence.new(
			0.1
		)
	)


	--====================================================--
	-- LIGHT
	--====================================================--

	safeSet(
		obj,
		"LightEmission",
		0
	)


	safeSet(
		obj,
		"LightInfluence",
		1
	)


	safeSet(
		obj,
		"Brightness",
		0
	)


	--====================================================--
	-- TRANSPARENCY
	--====================================================--

	safeSet(
		obj,
		"Transparency",
		NumberSequence.new(
			0
		)
	)

end


--========================================================--
-- FIRE / SMOKE / SPARKLES
--========================================================--

