		safeSet(
			obj,
			"Enabled",
			false
		)


		safeSet(
			obj,
			"Size",
			0
		)


		safeSet(
			obj,
			"Opacity",
			0
		)


		safeSet(
			obj,
			"RiseVelocity",
			0
		)


		return

