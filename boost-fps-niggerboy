--========================================================--
-- DECAL / TEXTURE
--========================================================--

local function optimizeDecalOrTexture(obj)


	if not obj:IsA("Decal")
		and not obj:IsA("Texture") then

		return

	end


	if not
		CONFIG.REDUCE_DECAL_TRANSPARENCY_EFFECTS
	then

		return

	end


	--====================================================--
	-- GẦN VÔ HÌNH -> LOCAL HIDDEN
	--====================================================--

	safe(
		function()


			if obj.Transparency >= 0.985 then


				obj.LocalTransparencyModifier =
					1


			elseif obj.Transparency >= 0.8 then


				obj.LocalTransparencyModifier =
					0.5


			end


		end
	)


	--====================================================--
	-- TEXTURE SCROLL STOP
	--====================================================--

	if obj:IsA("Texture") then


		safeSet(
			obj,
			"OffsetStudsU",
			0
		)


		safeSet(
			obj,
			"OffsetStudsV",
			0
		)


	end

end


--========================================================--
-- ALMOST INVISIBLE PARTS
--========================================================--

local function optimizeTransparentPart(obj)


	if not obj:IsA("BasePart") then

		return

	end


	if not
		CONFIG.HIDE_ALMOST_INVISIBLE_PARTS
	then

		return

	end


	safe(
		function()


			if obj.Transparency
				>= CONFIG.INVISIBLE_THRESHOLD then


				obj.LocalTransparencyModifier =
					1


			end


		end
	)

end


--========================================================--
-- MASTER OPTIMIZER
--========================================================--

local function optimize(obj)


	--====================================================--
	-- LIGHT
	--====================================================--

	disableAllLights(obj)


	--====================================================--
	-- MATERIAL
	--====================================================--

	flattenMaterial(obj)


	--====================================================--
	-- MESH TEXTURE
	--====================================================--

	optimizeMeshTexture(obj)


	--====================================================--
	-- PART
	--====================================================--

	optimizeTransparentPart(obj)


	--====================================================--
	-- PBR
	--====================================================--

	optimizeSurfaceAppearance(obj)


	--====================================================--
	-- POST EFFECT
	--====================================================--

	disablePostEffect(obj)


	--====================================================--
	-- PARTICLE
	--====================================================--

	minimizeParticle(obj)


	--====================================================--
	-- BEAM
	--====================================================--

	minimizeBeam(obj)


	--====================================================--
	-- TRAIL
	--====================================================--

	minimizeTrail(obj)


	--====================================================--
	-- CLASSIC VFX
	--====================================================--

	minimizeClassicVFX(obj)


	--====================================================--
	-- SPECIAL EFFECTS
	--====================================================--

	optimizeSpecialEffects(obj)


	--====================================================--
	-- DECAL / TEXTURE
	--====================================================--

	optimizeDecalOrTexture(obj)

end


--========================================================--
-- INITIAL FORCE
--========================================================--

forceGraphicsQuality()

forceFullBright()

forceLighting()

optimizeTerrain()


--========================================================--
-- INITIAL LIGHTING
--========================================================--

for _, obj in ipairs(
	Lighting:GetChildren()
) do


	optimizeLightingChild(obj)

	disableAllLights(obj)


end


--========================================================--
-- INITIAL WORKSPACE
--========================================================--

for _, obj in ipairs(
	Workspace:GetDescendants()
) do


	optimize(obj)


end


--========================================================--
-- NEW / STREAMED OBJECT
--========================================================--

Workspace.DescendantAdded:Connect(

	function(obj)


		task.defer(

			function()


				if obj
					and obj.Parent then


					optimize(obj)


				end


			end
		)


	end

)


--========================================================--
-- LIGHTING CHILD ADDED
--========================================================--

Lighting.ChildAdded:Connect(

	function(obj)


		task.defer(

			function()


				if obj
					and obj.Parent == Lighting then


					optimizeLightingChild(obj)

					disableAllLights(obj)


				end


			end
		)


	end

)


--========================================================--
-- CAMERA
--========================================================--

local function optimizeCamera(camera)


	if not camera then

		return

	end


	--====================================================--
	-- EXISTING CAMERA EFFECTS
	--====================================================--

	for _, obj in ipairs(
		camera:GetChildren()
	) do


		disablePostEffect(obj)

		disableAllLights(obj)


	end


	--====================================================--
	-- FUTURE CAMERA EFFECTS
	--====================================================--

	camera.ChildAdded:Connect(

		function(obj)


			task.defer(

				function()


					if obj
						and obj.Parent == camera then


						disablePostEffect(obj)

						disableAllLights(obj)


					end


				end
			)


		end
	)

end


optimizeCamera(
	Workspace.CurrentCamera
)


--========================================================--
-- CAMERA CHANGES
--========================================================--

Workspace:GetPropertyChangedSignal(
	"CurrentCamera"
):Connect(

	function()


		task.defer(

			function()


				optimizeCamera(
					Workspace.CurrentCamera
				)


			end
		)


	end

)


--========================================================--
-- CONTINUOUS ENFORCER
--========================================================--
--
-- Không quét toàn bộ object mỗi frame.
--
-- 0.5 giây:
--   • đủ nhanh để chống effect được bật lại
--   • không biến optimizer thành một nguồn lag mới
--
--========================================================--

task.spawn(

	function()


		while true do


			--================================================--
			-- GRAPHICS QUALITY
			--================================================--

			forceGraphicsQuality()


			--================================================--
			-- FULLBRIGHT
			--================================================--

			forceFullBright()


			--================================================--
			-- GLOBAL LIGHTING
			--================================================--

			forceLighting()


			--================================================--
			-- TERRAIN
			--================================================--

			optimizeTerrain()


			--================================================--
			-- LIGHTING
			--================================================--

			for _, obj in ipairs(
				Lighting:GetChildren()
			) do


				optimizeLightingChild(obj)

				disableAllLights(obj)


			end


			--================================================--
			-- CAMERA
			--================================================--

			local camera =
				Workspace.CurrentCamera


			if camera then


				for _, obj in ipairs(
					camera:GetChildren()
				) do


					disablePostEffect(obj)

					disableAllLights(obj)


				end


			end


			--================================================--
			-- WORLD LIGHT SOURCES
			--================================================--

			for _, obj in ipairs(
				Workspace:GetDescendants()
			) do


				if obj:IsA("Light") then

					disableAllLights(obj)

				end


			end


			--================================================--
			-- MATERIALS THAT MAY HAVE BEEN RESTORED
			--================================================--
			--
			-- Chỉ xử lý BasePart.
			--
			-- Điều này giữ optimizer mạnh ngay cả khi game
			-- thay Material sau khi object được tạo.
			--
			--================================================--

			for _, obj in ipairs(
				Workspace:GetDescendants()
			) do


				if obj:IsA("BasePart") then

					flattenMaterial(obj)

				end


			end


			--================================================--
			-- WAIT
			--================================================--

			task.wait(
				CONFIG.ENFORCE_INTERVAL
			)


		end

	end

)
