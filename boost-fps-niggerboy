-- override tuỳ chọn từ ngoài: getgenv().ULTRA_LOW_GRAPHICS = { DISABLE_BEAMS = true, ... }
if type(getgenv) == "function" and type(getgenv().ULTRA_LOW_GRAPHICS) == "table" then
    for key, value in pairs(getgenv().ULTRA_LOW_GRAPHICS) do
        CONFIG[key] = value
    end
end

--──────────────────── Chống chạy trùng khi execute lại ────────────────────
local ENV = (type(getgenv) == "function") and getgenv() or _G

if type(ENV.__ULTRA_LOW_STOP) == "function" then
    pcall(ENV.__ULTRA_LOW_STOP)
end
if type(ENV.__ULTRA_LOW_CONNS) == "table" then
    for _, conn in ipairs(ENV.__ULTRA_LOW_CONNS) do
        pcall(function() conn:Disconnect() end)
    end
end

local RUNNING = true
local CONNS = {}

ENV.__ULTRA_LOW_STOP = function()
    RUNNING = false
    for _, conn in ipairs(CONNS) do
        pcall(function() conn:Disconnect() end)
    end
end
ENV.__ULTRA_LOW_CONNS = CONNS

local function track(conn)
    table.insert(CONNS, conn)
    return conn
end

--──────────────────── Helper ────────────────────
local function safe(fn)
    pcall(fn)
end

local function safeSet(object, property, value)
    pcall(function()
        object[property] = value
    end)
end

--──────────────────── Render settings ────────────────────
local function applyRenderSettings()
    safe(function()
        UserSettings().GameSettings.SavedQualityLevel = CONFIG.TARGET_GRAPHICS_QUALITY
    end)

    if CONFIG.FORCE_RENDER_QUALITY_LEVEL1 then
        safe(function()
            settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
        end)
    end

    if CONFIG.DISABLE_ANTIALIASING then
        safe(function()
            settings().Rendering.Antialiasing = false
        end)
    end

    if CONFIG.UNLOCK_FPS then
        safe(function()
            settings().Rendering.FrameRateCap = CONFIG.FPS_CAP
        end)
        safe(function()
            UserSettings().GameSettings.FramerateCap = CONFIG.FPS_CAP
        end)
        if type(setfpscap) == "function" then
            pcall(setfpscap, CONFIG.FPS_CAP)
        end
    end
end

--──────────────────── Lighting ────────────────────
local function forceFullBright()
    if not CONFIG.ENABLE_FULLBRIGHT then
        return
    end

    safeSet(Lighting, "GlobalShadows", false)
    safeSet(Lighting, "Brightness", CONFIG.FULLBRIGHT_BRIGHTNESS)
    safeSet(Lighting, "Ambient", CONFIG.FULLBRIGHT_AMBIENT)
    safeSet(Lighting, "OutdoorAmbient", CONFIG.FULLBRIGHT_OUTDOOR_AMBIENT)
    safeSet(Lighting, "ColorShift_Top", CONFIG.FULLBRIGHT_COLOR_SHIFT)
    safeSet(Lighting, "ColorShift_Bottom", CONFIG.FULLBRIGHT_COLOR_SHIFT)
    safeSet(Lighting, "ExposureCompensation", CONFIG.FULLBRIGHT_EXPOSURE)
    safeSet(Lighting, "EnvironmentDiffuseScale", 0)
    safeSet(Lighting, "EnvironmentSpecularScale", 0)
    safeSet(Lighting, "ShadowSoftness", 0)
end

local function forceLighting()
    forceFullBright()

    if CONFIG.DISABLE_GLOBAL_SHADOWS then
        safeSet(Lighting, "GlobalShadows", false)
    end
    if CONFIG.DISABLE_ENVIRONMENT_DIFFUSE then
        safeSet(Lighting, "EnvironmentDiffuseScale", 0)
    end
    if CONFIG.DISABLE_ENVIRONMENT_SPECULAR then
        safeSet(Lighting, "EnvironmentSpecularScale", 0)
    end
    if CONFIG.DISABLE_OUTLINES then
        safeSet(Lighting, "Outlines", false)
    end
    if CONFIG.FORCE_COMPATIBLE_LIGHTING then
        safeSet(Lighting, "Technology", Enum.Technology.Compatibility)
    end

    if CONFIG.RENDER_DISTANCE_FOG then
        safeSet(Lighting, "FogColor", CONFIG.FULLBRIGHT_AMBIENT)
        safeSet(Lighting, "FogStart", CONFIG.FOG_START)
        safeSet(Lighting, "FogEnd", CONFIG.FOG_END)
    elseif CONFIG.DISABLE_FOG then
        safeSet(Lighting, "FogStart", 0)
        safeSet(Lighting, "FogEnd", 1000000)
    end
end

--──────────────────── Lights ────────────────────
local function disableAllLights(obj)
    if not CONFIG.DISABLE_ALL_LIGHTS then
        return
    end
    if not obj:IsA("Light") then
        return
    end

    safeSet(obj, "Enabled", false)
    safeSet(obj, "Brightness", 0)
    safeSet(obj, "Range", 0)
    safeSet(obj, "Shadows", false)
end

--──────────────────── Parts / materials ────────────────────
local function flattenMaterial(obj)
    if not CONFIG.SIMPLIFY_ALL_MATERIALS then
        return
    end
    if not obj:IsA("BasePart") then
        return
    end

    if CONFIG.FLATTEN_GLASS then
        safe(function()
            if obj.Material == Enum.Material.Glass then
                obj.Material = Enum.Material.SmoothPlastic
                if CONFIG.OPAQUE_GLASS then
                    obj.Transparency = 0
                end
            end
        end)
    end

    safeSet(obj, "Material", CONFIG.FLAT_MATERIAL)

    if CONFIG.DISABLE_REFLECTANCE then
        safeSet(obj, "Reflectance", 0)
    end
    if CONFIG.REMOVE_MATERIAL_VARIANT then
        safeSet(obj, "MaterialVariant", "")
    end
    if CONFIG.DISABLE_PART_SHADOWS then
        safeSet(obj, "CastShadow", false)
    end

    if CONFIG.FLATTEN_LEGACY_SURFACES then
        safeSet(obj, "TopSurface", Enum.SurfaceType.Smooth)
        safeSet(obj, "BottomSurface", Enum.SurfaceType.Smooth)
        safeSet(obj, "FrontSurface", Enum.SurfaceType.Smooth)
        safeSet(obj, "BackSurface", Enum.SurfaceType.Smooth)
        safeSet(obj, "LeftSurface", Enum.SurfaceType.Smooth)
        safeSet(obj, "RightSurface", Enum.SurfaceType.Smooth)
    end
end

local function optimizeMeshes(obj)
    if obj:IsA("MeshPart") then
        if CONFIG.REMOVE_MESHPART_TEXTURES then
            safeSet(obj, "TextureID", "")
        end
        if CONFIG.DISABLE_DOUBLE_SIDED_MESHES then
            safeSet(obj, "DoubleSided", false)
        end
    end

    if CONFIG.FORCE_LOW_RENDER_FIDELITY and (obj:IsA("MeshPart") or obj:IsA("UnionOperation")) then
        safeSet(obj, "RenderFidelity", Enum.RenderFidelity.Performance)
    end
end

local function optimizeSpecialMesh(obj)
    if not obj:IsA("SpecialMesh") then
        return
    end
    if CONFIG.REMOVE_SPECIALMESH_TEXTURES then
        safeSet(obj, "TextureId", "")
    end
end

local function optimizeSurfaceAppearance(obj)
    if not CONFIG.REMOVE_SURFACE_APPEARANCE then
        return
    end
    if not obj:IsA("SurfaceAppearance") then
        return
    end
    safe(function()
        obj:Destroy()
    end)
end

local function optimizeTransparentPart(obj)
    if not CONFIG.HIDE_ALMOST_INVISIBLE_PARTS then
        return
    end
    if not obj:IsA("BasePart") then
        return
    end

    safe(function()
        if obj.Transparency >= CONFIG.INVISIBLE_THRESHOLD then
            obj.LocalTransparencyModifier = 1
        end
    end)
end

--──────────────────── Post effects / sky ────────────────────
local function disablePostEffect(obj)
    if not CONFIG.DISABLE_POST_EFFECTS then
        return
    end
    if obj:IsA("PostEffect") then
        safeSet(obj, "Enabled", false)
    end
end

local function optimizeLightingChild(obj)
    if obj:IsA("PostEffect") then
        disablePostEffect(obj)
        return
    end

    if obj:IsA("Atmosphere") and CONFIG.DISABLE_ATMOSPHERE then
        safeSet(obj, "Density", 0)
        safeSet(obj, "Offset", 0)
        safeSet(obj, "Glare", 0)
        safeSet(obj, "Haze", 0)
        return
    end

    if obj:IsA("Clouds") and CONFIG.DISABLE_CLOUDS then
        safeSet(obj, "Enabled", false)
        safeSet(obj, "Cover", 0)
        safeSet(obj, "Density", 0)
    end
end

--──────────────────── Terrain ────────────────────
local function optimizeTerrain()
    Terrain = Workspace:FindFirstChildOfClass("Terrain")
    if not Terrain then
        return
    end

    if CONFIG.DISABLE_TERRAIN_DECORATION then
        safeSet(Terrain, "Decoration", false)
    end
    if CONFIG.DISABLE_WATER_REFLECTION then
        safeSet(Terrain, "WaterReflectance", 0)
        safeSet(Terrain, "WaterRefraction", 0)
    end
    if CONFIG.DISABLE_WATER_WAVES then
        safeSet(Terrain, "WaterWaveSize", 0)
        safeSet(Terrain, "WaterWaveSpeed", 0)
    end
    if CONFIG.CLEAR_TERRAIN then
        safe(function() Terrain:Clear() end)
    end
end

--──────────────────── Particles ────────────────────
local function isDustParticle(obj)
    local name = string.lower(obj.Name)

    local dustWords = {
        "dust", "dusty", "dustcloud", "dust_cloud", "dustparticle", "dustparticleemitter",
        "debris", "debrisfx", "debrisparticle", "ash", "ashparticle",
        "mist", "mistparticle", "mistfx", "fog", "fogparticle",
        "pollen", "pollenparticle", "sand", "sandparticle",
        "dirt", "dirtparticle", "mote", "motes", "speck", "specks",
        "ambientdust", "ambient_dust", "floatingdust", "floating_dust",
        "grounddust", "ground_dust", "airdust", "air_dust",
    }

    for _, word in ipairs(dustWords) do
        if string.find(name, word, 1, true) then
            return true
        end
    end

    return false
end

local function minimizeParticle(obj)
    if not obj:IsA("ParticleEmitter") then
        return
    end

    -- MỚI: tắt hẳn toàn bộ particle
    if CONFIG.DISABLE_ALL_PARTICLES then
        safeSet(obj, "Enabled", false)
        safeSet(obj, "Rate", 0)
        safe(function() obj:Clear() end)
        if CONFIG.REMOVE_VFX_TEXTURES then
            safeSet(obj, "Texture", "")
        end
        return
    end

    if CONFIG.DISABLE_DUST and isDustParticle(obj) then
        safeSet(obj, "Enabled", false)
        safeSet(obj, "Rate", 0)
        safe(function() obj:Clear() end)
        return
    end

    if not CONFIG.ENABLE_EXTREME_PARTICLE_REDUCTION then
        return
    end

    if CONFIG.REMOVE_VFX_TEXTURES then
        safeSet(obj, "Texture", "")
    end

    safe(function() obj.Rate = math.min(obj.Rate, 2) end)
    safeSet(obj, "Lifetime", NumberRange.new(0.08, 0.18))
    safeSet(obj, "Size", NumberSequence.new(0.08))

    if CONFIG.DISABLE_PARTICLE_MOTION then
        safeSet(obj, "Speed", NumberRange.new(0, 0))
        safeSet(obj, "Acceleration", Vector3.zero)
        safeSet(obj, "VelocityInheritance", 0)
        safeSet(obj, "Drag", 1)
        safeSet(obj, "SpreadAngle", Vector2.zero)
        safeSet(obj, "VelocitySpread", 0)
    end

    if CONFIG.DISABLE_PARTICLE_ROTATION then
        safeSet(obj, "Rotation", NumberRange.new(0, 0))
        safeSet(obj, "RotSpeed", NumberRange.new(0, 0))
    end

    safeSet(obj, "Squash", NumberSequence.new(0))
    safeSet(obj, "ZOffset", 0)

    if CONFIG.DISABLE_PARTICLE_LIGHTING then
        safeSet(obj, "LightEmission", 0)
        safeSet(obj, "LightInfluence", 1)
        safeSet(obj, "Brightness", 0)
    end

    if CONFIG.DISABLE_FLIPBOOK_ANIMATION then
        safeSet(obj, "FlipbookLayout", Enum.ParticleFlipbookLayout.None)
        safeSet(obj, "FlipbookFramerate", NumberRange.new(0, 0))
        safeSet(obj, "FlipbookStartRandom", false)
    end

    if CONFIG.REDUCE_PARTICLE_TRANSPARENCY then
        safeSet(obj, "Transparency", NumberSequence.new(0))
    end

    safeSet(obj, "WindAffectsDrag", false)
    safeSet(obj, "LockedToPart", false)
    safeSet(obj, "Orientation", Enum.ParticleOrientation.FacingCamera)
end

local function minimizeBeam(obj)
    if not obj:IsA("Beam") then
        return
    end

    if CONFIG.DISABLE_BEAMS then
        safeSet(obj, "Enabled", false)
        return
    end
    if not CONFIG.ENABLE_EXTREME_BEAM_REDUCTION then
        return
    end

    if CONFIG.REMOVE_VFX_TEXTURES then
        safeSet(obj, "Texture", "")
    end

    safeSet(obj, "TextureSpeed", 0)
    safeSet(obj, "Segments", 1)
    safe(function() obj.Width0 = math.min(obj.Width0, 0.1) end)
    safe(function() obj.Width1 = math.min(obj.Width1, 0.1) end)
    safeSet(obj, "CurveSize0", 0)
    safeSet(obj, "CurveSize1", 0)
    safeSet(obj, "LightEmission", 0)
    safeSet(obj, "LightInfluence", 1)
    safeSet(obj, "Brightness", 0)
    safeSet(obj, "Transparency", NumberSequence.new(0))
end

local function minimizeTrail(obj)
    if not obj:IsA("Trail") then
        return
    end

    if CONFIG.DISABLE_TRAILS then
        safeSet(obj, "Enabled", false)
        return
    end
    if not CONFIG.ENABLE_EXTREME_TRAIL_REDUCTION then
        return
    end

    if CONFIG.REMOVE_VFX_TEXTURES then
        safeSet(obj, "Texture", "")
    end

    safe(function() obj.Lifetime = math.min(obj.Lifetime, 0.05) end)
    safeSet(obj, "MinLength", 0)
    safeSet(obj, "WidthScale", NumberSequence.new(0.1))
    safeSet(obj, "FaceCamera", true)
    safeSet(obj, "LightEmission", 0)
    safeSet(obj, "LightInfluence", 1)
    safeSet(obj, "Brightness", 0)
    safeSet(obj, "Transparency", NumberSequence.new(0))
end

--──────────────────── VFX khác ────────────────────
local function minimizeClassicVFX(obj)
    if CONFIG.DISABLE_FIRE and obj:IsA("Fire") then
        safeSet(obj, "Enabled", false)
        safeSet(obj, "Heat", 0)
        safeSet(obj, "Size", 0)
        return
    end

    if CONFIG.DISABLE_SMOKE and obj:IsA("Smoke") then
        safeSet(obj, "Enabled", false)
        safeSet(obj, "Size", 0)
        safeSet(obj, "Opacity", 0)
        safeSet(obj, "RiseVelocity", 0)
        return
    end

    if CONFIG.DISABLE_SPARKLES and obj:IsA("Sparkles") then
        safeSet(obj, "Enabled", false)
    end
end

local function optimizeSpecialEffects(obj)
    if CONFIG.DISABLE_HIGHLIGHTS and obj:IsA("Highlight") then
        safeSet(obj, "Enabled", false)
    end
    if CONFIG.DISABLE_FORCEFIELDS and obj:IsA("ForceField") then
        safeSet(obj, "Visible", false)
    end
    if CONFIG.DISABLE_SELECTION_EFFECTS and obj:IsA("SelectionBox") then
        safeSet(obj, "Visible", false)
    end
    if CONFIG.DISABLE_SELECTION_EFFECTS and obj:IsA("SelectionSphere") then
        safeSet(obj, "Visible", false)
    end
end

--──────────────────── Decal / Texture ────────────────────
local function optimizeDecalOrTexture(obj)
    if not obj:IsA("Decal") and not obj:IsA("Texture") then
        return
    end

    -- MỚI: làm mờ toàn bộ decal
    if CONFIG.REMOVE_ALL_DECALS then
        safeSet(obj, "Transparency", 1)
        safeSet(obj, "LocalTransparencyModifier", 1)
        return
    end

    if CONFIG.REDUCE_DECAL_TRANSPARENCY_EFFECTS then
        safe(function()
            if obj.Transparency >= 0.985 then
                obj.LocalTransparencyModifier = 1
            elseif obj.Transparency >= 0.8 then
                obj.LocalTransparencyModifier = 0.5
            end
        end)
    end

    if obj:IsA("Texture") then
        safeSet(obj, "OffsetStudsU", 0)
        safeSet(obj, "OffsetStudsV", 0)
    end
end

--──────────────────── GUI 3D / Humanoid ────────────────────
local function optimizeMisc(obj)
    if CONFIG.HIDE_NAME_TAGS and obj:IsA("Humanoid") then
        safeSet(obj, "DisplayDistanceType", Enum.HumanoidDisplayDistanceType.None)
        safeSet(obj, "HealthDisplayType", Enum.HumanoidHealthDisplayType.AlwaysOff)
    end
    if CONFIG.HIDE_BILLBOARD_GUIS and obj:IsA("BillboardGui") then
        safeSet(obj, "Enabled", false)
    end
    if CONFIG.HIDE_SURFACE_GUIS and obj:IsA("SurfaceGui") then
        safeSet(obj, "Enabled", false)
    end
end

--──────────────────── Tổng hợp ────────────────────
local function optimize(obj)
    disableAllLights(obj)
    flattenMaterial(obj)
    optimizeMeshes(obj)
    optimizeSpecialMesh(obj)
    optimizeTransparentPart(obj)
    optimizeSurfaceAppearance(obj)
    disablePostEffect(obj)
    minimizeParticle(obj)
    minimizeBeam(obj)
    minimizeTrail(obj)
    minimizeClassicVFX(obj)
    optimizeSpecialEffects(obj)
    optimizeDecalOrTexture(obj)
    optimizeMisc(obj)
end

local function enforcePartFast(obj)
    if CONFIG.DISABLE_PART_SHADOWS then
        safeSet(obj, "CastShadow", false)
    end
    if CONFIG.SIMPLIFY_ALL_MATERIALS then
        safeSet(obj, "Material", CONFIG.FLAT_MATERIAL)
    end
    if obj:IsA("MeshPart") then
        if CONFIG.REMOVE_MESHPART_TEXTURES then
            safeSet(obj, "TextureID", "")
        end
        if CONFIG.FORCE_LOW_RENDER_FIDELITY then
            safeSet(obj, "RenderFidelity", Enum.RenderFidelity.Performance)
        end
        if CONFIG.DISABLE_DOUBLE_SIDED_MESHES then
            safeSet(obj, "DoubleSided", false)
        end
    end
end

--──────────────────── Camera ────────────────────
local function optimizeCamera(camera)
    if not camera then
        return
    end

    for _, obj in ipairs(camera:GetChildren()) do
        disablePostEffect(obj)
        disableAllLights(obj)
    end

    track(camera.ChildAdded:Connect(function(obj)
        task.defer(function()
            if obj and obj.Parent == camera then
                disablePostEffect(obj)
                disableAllLights(obj)
            end
        end)
    end))
end

--──────────────────── Hàng đợi instance mới (batch, nhẹ máy) ────────────────────
local pendingQueue = {}
local pendingSet = {}

local function enqueue(obj)
    if pendingSet[obj] then
        return
    end
    pendingSet[obj] = true
    pendingQueue[#pendingQueue + 1] = obj
end

track(Workspace.DescendantAdded:Connect(enqueue))

track(Lighting.ChildAdded:Connect(function(obj)
    task.defer(function()
        if obj and obj.Parent == Lighting then
            optimizeLightingChild(obj)
            disableAllLights(obj)
        end
    end)
end))

track(Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
    task.defer(function()
        optimizeCamera(Workspace.CurrentCamera)
    end)
end))

task.spawn(function()
    while RUNNING do
        if #pendingQueue == 0 then
            task.wait(0.03)
        else
            local batch = pendingQueue
            pendingQueue = {}
            pendingSet = {}

            for i = 1, #batch do
                local obj = batch[i]
                if obj.Parent then
                    optimize(obj)
                end
                if i % 300 == 0 then
                    task.wait()
                end
            end
        end
    end
end)

--──────────────────── Khởi động ────────────────────
applyRenderSettings()
forceLighting()
optimizeTerrain()

if CONFIG.TRY_ENABLE_STREAMING then
    safe(function() Workspace.StreamingEnabled = true end)
end

optimizeCamera(Workspace.CurrentCamera)

for _, obj in ipairs(Lighting:GetChildren()) do
    optimizeLightingChild(obj)
    disableAllLights(obj)
end

-- quét toàn bộ map lần đầu (chia nhỏ để không đơ máy)
task.spawn(function()
    local descendants = Workspace:GetDescendants()
    for i, obj in ipairs(descendants) do
        if not RUNNING then break end
        optimize(obj)
        if i % 400 == 0 then
            task.wait()
        end
    end
end)

--──────────────────── Vòng lặp ép buộc (nhanh, mỗi 0.5s) ────────────────────
task.spawn(function()
    while RUNNING do
        applyRenderSettings()
        forceLighting()
        optimizeTerrain()

        for _, obj in ipairs(Lighting:GetChildren()) do
            optimizeLightingChild(obj)
            disableAllLights(obj)
        end

        local camera = Workspace.CurrentCamera
        if camera then
            for _, obj in ipairs(camera:GetChildren()) do
                disablePostEffect(obj)
                disableAllLights(obj)
            end
        end

        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("Light") then
                disableAllLights(obj)
            elseif obj:IsA("BasePart") then
                enforcePartFast(obj)
            elseif obj:IsA("ParticleEmitter") then
                if CONFIG.DISABLE_ALL_PARTICLES then
                    safeSet(obj, "Enabled", false)
                    safeSet(obj, "Rate", 0)
                end
            elseif obj:IsA("PostEffect") then
                disablePostEffect(obj)
            elseif obj:IsA("Decal") then
                if CONFIG.REMOVE_ALL_DECALS then
                    safeSet(obj, "Transparency", 1)
                    safeSet(obj, "LocalTransparencyModifier", 1)
                end
            end
        end

        task.wait(CONFIG.ENFORCE_INTERVAL)
    end
end)

--──────────────────── Full sweep định kỳ (chặn game bật lại mọi thứ) ────────────────────
if CONFIG.FULL_SWEEP_INTERVAL and CONFIG.FULL_SWEEP_INTERVAL > 0 then
    task.spawn(function()
        while RUNNING do
            task.wait(CONFIG.FULL_SWEEP_INTERVAL)
            if not RUNNING then break end

            local descendants = Workspace:GetDescendants()
            for i, obj in ipairs(descendants) do
                if not RUNNING then break end
                optimize(obj)
                if i % 400 == 0 then
                    task.wait()
                end
            end
        end
    end)
end

