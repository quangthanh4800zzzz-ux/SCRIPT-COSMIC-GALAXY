	--====================================================--

	if CONFIG.DISABLE_FIRE
		and obj:IsA("Fire") then


		safeSet(
			obj,
			"Enabled",
			false
		)


		safeSet(
			obj,
			"Heat",
			0
		)


		safeSet(
			obj,
			"Size",
			0
		)


		return

	end


	--====================================================--
	-- SMOKE
	--====================================================--

	if CONFIG.DISABLE_SMOKE
