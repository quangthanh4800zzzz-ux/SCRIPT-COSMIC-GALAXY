--========================================================--
-- ROBLOX CLIENT VISUAL MINIMIZER
-- EXTREME FULLBRIGHT + MATERIAL FLATTENER
--========================================================--
--
-- StarterPlayer
--     └── StarterPlayerScripts
--             └── LocalScript
--
--========================================================--
--
-- MỤC TIÊU
--
-- CLIENT QUALITY
-- • Graphics Quality = 7
-- • Không chỉnh StreamingTargetRadius
-- • Không chỉnh StreamingMinRadius
-- • Không phá chunk distance
--
-- FULLBRIGHT
-- • Ambient cao và đồng đều
-- • GlobalShadows OFF
-- • Sun/Moon contribution giảm về 0
-- • EnvironmentDiffuse = 0
-- • EnvironmentSpecular = 0
-- • ColorShift = 0
-- • Exposure = 0
--
-- LIGHT
-- • Tất cả PointLight OFF
-- • Tất cả SpotLight OFF
-- • Tất cả SurfaceLight OFF
-- • Brightness = 0
-- • Range = 0
-- • Shadows OFF
--
-- MATERIAL
-- • Part -> SmoothPlastic
-- • MeshPart -> SmoothPlastic
-- • WedgePart -> SmoothPlastic
-- • UnionOperation -> SmoothPlastic
-- • mọi BasePart -> SmoothPlastic
-- • MaterialVariant = ""
-- • Reflectance = 0
-- • CastShadow = false
-- • Glass -> SmoothPlastic
--
-- PBR
-- • SurfaceAppearance OFF / Destroy
-- • MaterialVariant OFF
--
-- POST EFFECT
-- • Bloom OFF
-- • Blur OFF
-- • ColorCorrection OFF
-- • DepthOfField OFF
-- • SunRays OFF
-- • mọi PostEffect OFF
-- • Atmosphere OFF
-- • Clouds OFF
--
-- PARTICLE
-- • Dust OFF
-- • Debris OFF
-- • Ash OFF
-- • Mist OFF
-- • Fog particles OFF
-- • Sand particles OFF
-- • Pollen OFF
-- • Smoke particles OFF
-- • Particle Rate giảm
-- • Lifetime giảm
-- • Size giảm
-- • Speed OFF
-- • Acceleration OFF
-- • Rotation OFF
-- • Flipbook OFF
-- • LightEmission OFF
-- • LightInfluence = 1
-- • Brightness = 0
-- • Transparency đơn giản
--
-- BEAM / TRAIL
-- • Texture animation OFF
-- • Segments giảm
-- • Curve OFF
-- • Width giảm
-- • LightEmission OFF
-- • Brightness = 0
--
-- CLASSIC VFX
-- • Fire OFF
-- • Smoke OFF
-- • Sparkles OFF
--
-- SPECIAL
-- • Highlight OFF
-- • ForceField OFF
-- • SelectionBox OFF
-- • SelectionSphere OFF
--
-- TERRAIN / WATER
-- • WaterReflectance = 0
-- • WaterWaveSize = 0
-- • WaterWaveSpeed = 0
--
-- TRANSPARENCY
-- • Object gần như vô hình -> local invisible
-- • Không replicate ngược server
--
-- AUTO ENFORCER
-- • Object mới -> xử lý
-- • Object streamed vào -> xử lý
-- • Light mới -> tắt
-- • Effect mới -> tắt
-- • Material mới -> flatten
--
--========================================================--


--========================================================--
-- SERVICES
--========================================================--

